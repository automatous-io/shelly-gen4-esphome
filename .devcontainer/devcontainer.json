  "name": "Shelly Gen4 ESPHome — release toolchain (ESPHome 2026.8.2)",
  "build": { "dockerfile": "Dockerfile" },

  "workspaceFolder": "/workspaces/shelly-gen4-esphome",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/shelly-gen4-esphome,type=bind",

  "mounts": [
    "source=shelly-gen4-esphome-cache,target=/cache,type=volume"
  ],

  "remoteUser": "root",

  "runArgs": ["--add-host=host.docker.internal:host-gateway"],

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.watcherExclude": { "**/.esphome/**": true },
        "search.exclude": { "**/.esphome/**": true },
        "python.defaultInterpreterPath": "/usr/local/bin/python3"
      }
    }
  }
}
